<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: every conversion runs against the local dist/ bundle served
         from app assets via WebViewAssetLoader. External links open in the system browser,
         which needs no permission from this app. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Convert"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!-- configChanges: a running conversion and its result live only in the WebView's page,
             so the activity must not be recreated (which reloads the page) for a change it can
             simply ride out. Besides rotation and dark mode that means split-screen, freeform
             resizing and folding (screenSize, smallestScreenSize, screenLayout, and density when
             a fold's two screens differ) and a keyboard or mouse being attached (keyboard,
             keyboardHidden, navigation). The WebView re-lays the page out itself. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
